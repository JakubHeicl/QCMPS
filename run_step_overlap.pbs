#!/bin/bash
#$ -N qcmps_step_overlap
#$ -cwd
#$ -j y
#$ -l h_rt=06:00:00
#$ -l h_vmem=8G

set -euo pipefail

cd "${SGE_O_WORKDIR:-$(dirname "$0")}"
mkdir -p logs

job_id="${JOB_ID:-local}"
exec > >(tee "logs/step_overlap_${job_id}.log") 2>&1

echo "Job ID: ${job_id}"
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "Started: $(date)"

source "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate qcmps

python -u -m experiments.step_overlap_with_reg

echo "Finished: $(date)"
